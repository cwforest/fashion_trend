# ─── 실행 모드 ─────────────────────────────────────────────
# live | mock   (mock = 키 없이 합성 데이터로 전체 파이프라인 검증)
SOURCE_MODE=mock
# claude | stub  (stub = LLM 호출 없이 규칙 기반 폴백)
LLM_MODE=stub

# ─── NAVER API HUB (쇼핑인사이트 / 검색어트렌드 / 문서검색) ───
# https://www.ncloud.com → API HUB 콘솔에서 발급
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=

# ─── 네이버 검색광고 API (키워드도구 — 연관어 + 월간 검색수 절대값) ───
# https://searchad.naver.com → 도구 → API 사용 관리 → 서비스 신청 (심사 없음)
# 위 API HUB 와 완전히 별개 체계. 인증은 요청마다 HMAC-SHA256 서명.
NAVER_AD_CUSTOMER_ID=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=

# ─── KOSIS 공유서비스 (통계청 온라인쇼핑동향조사) ──────────────
# https://kosis.kr/openapi
KOSIS_API_KEY=

# ─── Anthropic (속성 추출 + 리포트 작성) ──────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── 저장소 ──────────────────────────────────────────────────
DB_PATH=data/db/passion.sqlite
CACHE_DIR=data/cache
